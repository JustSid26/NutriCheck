<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy this file to NutriCheck/Secrets.plist and paste your OpenAI API key.
  NutriCheck/Secrets.plist is git-ignored. The app imports the key into the
  Keychain on first launch. You can also skip this and paste the key in Settings.
-->
<plist version="1.0">
<dict>
	<key>OPENAI_API_KEY</key>
	<string>YOUR_OPENAI_API_KEY</string>
</dict>
</plist>
